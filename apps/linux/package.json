{
  "name": "@pitchdog/reference-linux",
  "version": "0.1.0",
  "description": "Private project visual research library",
  "author": "pitch.dog",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && node --check src/main.mjs && node --check src/preload.mjs && node --check src/core-supervisor.mjs",
    "package:dir": "npm run build && electron-builder --dir",
    "package": "npm run build && electron-builder --linux pacman AppImage tar.gz"
  },
  "build": {
    "appId": "io.pitchdog.ReferenceLibrary",
    "productName": "Reference Library",
    "artifactName": "reference-library-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "../../release/linux"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "../../target/release/reference-core",
        "to": "bin/reference-core"
      }
    ],
    "linux": {
      "category": "Graphics",
      "executableName": "reference-library",
      "target": [
        "pacman",
        "AppImage",
        "tar.gz"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "libxss"
      ]
    }
  }
}
