{
  "name": "@pitchdog/reference-linux",
  "version": "0.1.0",
  "description": "Private project visual research library",
  "homepage": "https://github.com/bomkino/reference-library",
  "author": {
    "name": "pitch.dog",
    "email": "111725271+bomkino@users.noreply.github.com"
  },
  "desktopName": "Reference Library",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && node --check src/main.mjs && node --check src/preload.mjs && node --check src/core-supervisor.mjs && node --check src/resource-response.mjs",
    "package:dir": "npm run build && electron-builder --dir",
    "package": "npm run build && electron-builder --linux pacman AppImage tar.gz"
  },
  "build": {
    "appId": "io.pitchdog.ReferenceLibrary",
    "productName": "Reference Library",
    "artifactName": "reference-library-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "../../release/linux"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "../../target/release/reference-core",
        "to": "bin/reference-core"
      },
      {
        "from": "packaging/io.pitchdog.ReferenceLibrary.desktop",
        "to": "share/applications/io.pitchdog.ReferenceLibrary.desktop"
      },
      {
        "from": "packaging/io.pitchdog.ReferenceLibrary.xml",
        "to": "share/mime/packages/io.pitchdog.ReferenceLibrary.xml"
      },
      {
        "from": "../../assets/branding/reference-library-icon-1024.png",
        "to": "share/icons/reference-library.png"
      }
    ],
    "fileAssociations": [
      {
        "ext": "pitchlibrary",
        "name": "Reference Library package",
        "description": "Reference Library package",
        "mimeType": "application/x-pitchdog-reference-library",
        "role": "Editor"
      }
    ],
    "linux": {
      "category": "Graphics",
      "executableName": "reference-library",
      "icon": "../../assets/branding/reference-library-icon-1024.png",
      "syncDesktopName": true,
      "target": [
        "pacman",
        "AppImage",
        "tar.gz"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "libxss"
      ]
    }
  }
}
